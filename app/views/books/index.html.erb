<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="display-5 fw-bold">Book Library</h1>
  <%= link_to '+ New Book', new_book_path, class: "btn btn-primary shadow-sm" %>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body bg-white rounded">
    <%= form_for_filterrific @filterrific, html: { data: { controller: "autosubmit", turbo_frame: "results" }, class: "row g-3 align-items-end" } do |f| %>
      
      <div class="col-md-3">
        <label class="form-label text-muted fw-semibold small text-uppercase">Search Book or Author</label>
        <%= f.text_field :search_query, class: 'form-control', placeholder: "Type a name...", data: { action: "input->autosubmit#search" } %>
      </div>

      <div class="col-md-3">
        <label class="form-label text-muted fw-semibold small text-uppercase">Select Author</label>
        <%= f.select :with_author_id, @filterrific.select_options[:with_author_id], { include_blank: '- Any -' }, class: "form-select", data: { action: "change->autosubmit#submit" } %>
      </div>

      <div class="col-md-2">
        <label class="form-label text-muted fw-semibold small text-uppercase">Release Date</label>
        <%= f.date_field :with_release_date, class: 'form-control', data: { action: "change->autosubmit#submit" } %>
      </div>

      <div class="col-md-2">
        <label class="form-label text-muted fw-semibold small text-uppercase">Sort by</label>
        <%= f.select :sorted_by, [
          ['Newest Added', 'created_at_desc'], 
          ['Oldest Added', 'created_at_asc'],
          ['Newest Release', 'release_date_desc'], 
          ['Oldest Release', 'release_date_asc']
        ], {}, class: "form-select", data: { action: "change->autosubmit#submit" } %>
      </div>

      <div class="col-md-2">
        <%= link_to 'Reset Filters', reset_filterrific_url, class: 'btn btn-outline-secondary w-100', data: { turbo_frame: "_top" } %>
      </div>
      
    <% end %>
  </div>
</div>

<turbo-frame id="results">
  <%= render(partial: 'books/list', locals: { books: @books }) %>
</turbo-frame>