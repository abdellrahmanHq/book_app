<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow-sm border-0 mt-4">
      <div class="card-body p-5 text-center">
        <h1 class="display-5 fw-bold mb-3"><%= @book.name %></h1>
        
        <p class="text-muted fs-5 mb-4">
          By <strong><%= @book.author.name %></strong>
        </p>

        <div class="badge bg-light text-dark border p-2 mb-4 fs-6">
          Released: <%= @book.release_date.strftime("%B %d, %Y") %>
        </div>

        <hr class="mb-4">

        <div class="d-flex justify-content-center gap-3">
          <%= link_to '← Back to Library', books_path, class: "btn btn-outline-secondary" %>
          
          <% if @book.author == current_author %>
            <%= link_to 'Edit Book', edit_book_path(@book), class: "btn btn-primary" %>
            <%= link_to 'Delete', book_path(@book), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-danger" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>