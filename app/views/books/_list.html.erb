<div class="d-flex justify-content-between align-items-center mb-4">
  <div class="text-muted small fw-bold">
    <%= pluralize(@pagy.count, 'result') %> found
  </div>
  
  <%= link_to books_path(format: :csv, filterrific: @filterrific.to_hash), class: "btn btn-sm btn-success shadow-sm", data: { turbo: false } do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download me-1" viewBox="0 0 16 16">
      <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
      <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
    </svg>
    Download CSV
  <% end %>
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
  <% books.each do |book| %>
    <div class="col">
      <div class="card h-100 shadow-sm border-0 bg-white rounded-3">
        <div class="card-body d-flex flex-column p-4">
          
          <h5 class="card-title fw-bold mb-1">
            <%= link_to book.name, book_path(book), class: "text-dark text-decoration-none", data: { turbo_frame: "_top" } %>
          </h5>
          
          <p class="card-text text-muted small mb-3">
            By <%= book.author.name %>
          </p>
          
          <div class="mt-auto">
            <span class="badge bg-light text-dark border mb-3">
              <%= book.release_date.strftime("%b %d, %Y") if book.release_date %>
            </span>
            
            <% if book.author == current_author %>
              <div class="d-flex gap-2">
                <%= link_to 'Edit', edit_book_path(book), class: "btn btn-sm btn-outline-primary w-50", data: { turbo_frame: "_top" } %>
                <%= link_to 'Delete', book_path(book), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?', turbo_frame: "_top" }, class: "btn btn-sm btn-outline-danger w-50" %>
              </div>
            <% end %>
          </div>

        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="d-flex justify-content-center mt-4">
  <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
</div>