<!DOCTYPE html>
<html>
  <head>
    <title>BookApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-bold" href="<%= books_path %>">📚 BookApp</a>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <div class="navbar-nav me-auto">
            <%= link_to "Books", books_path, class: "nav-link" %>
            <%= link_to "Authors", authors_path, class: "nav-link" %>
          </div>

          <div class="navbar-nav align-items-center">
            <% if author_signed_in? %>
              <span class="nav-link text-light me-3">
                Hello, <%= current_author.name || current_author.email %>
              </span>
              <%# Rails 7/8 requires data: { turbo_method: :delete } for logout links %>
              <%= link_to "Logout", destroy_author_session_path, data: { turbo_method: :delete }, class: "btn btn-sm btn-outline-danger" %>
            <% else %>
              <%= link_to "Login", new_author_session_path, class: "nav-link me-2" %>
              <%= link_to "Sign Up", new_author_registration_path, class: "btn btn-sm btn-primary" %>
            <% end %>
          </div>
        </div>
        
      </div>
    </nav>
    <main class="container mb-5">
      
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mt-3" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
      
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
  </body>
</html>