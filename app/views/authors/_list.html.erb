<div class="mb-3 text-muted small fw-bold">
  <%= pluralize(@pagy.count, 'result') %> found
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
  <% authors.each do |author| %>
    <div class="col">
      <div class="card h-100 shadow-sm border-0 bg-white rounded-3">
        <div class="card-body d-flex flex-column align-items-center justify-content-center p-4 text-center">
          <h5 class="card-title text-dark fw-bold mb-1"><%= author.name %></h5>
          <p class="card-text text-muted small mt-2">
            Published Books: <span class="badge bg-primary rounded-pill"><%= author.books.count %></span>
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="d-flex justify-content-center mt-4">
  <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
</div>